<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      PERMISOS DE HEALTH CONNECT.
      Nótese que NO se declara ACCESS_FINE_LOCATION ni COARSE: el sistema es
      offline-first y la derivación al COP se resuelve preguntando la provincia
      por chat (principio P6 — mínimos permisos; minimización RGPD art. 5.1.c).
      Se declaran EXACTAMENTE los tres tipos que la app lee; READ_HEART_RATE
      figuraba aquí sin que ningún punto del código leyera HeartRateRecord.
    -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />

    <!--
      VISIBILIDAD DEL PAQUETE DE HEALTH CONNECT.
      Obligatoria desde Android 11 por las reglas de visibilidad de paquetes.
      En Android 14+ Health Connect va integrado en el sistema y se ve sin
      esto, pero por debajo (minSdk es 28) es una aplicación aparte: sin la
      declaración, getSdkStatus() no puede verla y la informa como NO
      DISPONIBLE, con lo que la pantalla de dispositivos deshabilita la
      conexión en los dispositivos donde precisamente hace falta.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- Notificaciones para las micro-interacciones EMA y avisos suaves -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BurnoutApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BurnoutApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BurnoutApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              A partir de Android 14, Health Connect se integra en el SO y la app
              debe declarar el manejo de la pantalla de "política de privacidad"
              que solicita el sistema al conceder permisos de salud.
            -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Para Android 13 y anteriores, el rationale se declara como activity-alias -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
